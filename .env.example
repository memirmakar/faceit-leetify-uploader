# Copy this file to ".env" and fill in your values. Keep .env private.
# (The installer creates this for you.)

# How to find your matches:
#   api     = FACEIT Data API (needs a free key below) — most reliable
#   browser = your logged-in browser session (no key or nickname needed)
DISCOVERY_MODE=api

# --- Required for DISCOVERY_MODE=api (ignored in browser mode) ---
# Your FACEIT nickname (case-sensitive).
FACEIT_NICKNAME=
# Free FACEIT Data API key (Bearer). Create at https://developers.faceit.com
# -> your app -> API Keys -> new key with Data API access.
# This is NOT the paused Downloads API key.
FACEIT_DATA_API_KEY=

# --- Optional overrides (defaults are fine) ---
# LOOKBACK_DAYS=30
# HISTORY_LIMIT=20
# MAX_PER_RUN=
# DELAY_MS=4000
# BROWSER_CHANNEL=msedge   # msedge | chrome | chromium (bundled)
