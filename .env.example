# Copy this file to ".env" and fill in your values. Keep .env private.

# Your FACEIT nickname (case-sensitive).
FACEIT_NICKNAME=

# Free FACEIT Data API key (Bearer token).
# Create at https://developers.faceit.com -> your app -> API Keys -> new key
# with Data API access. This is NOT the paused Downloads API key.
FACEIT_DATA_API_KEY=

# --- Optional overrides (defaults are fine) ---
# LOOKBACK_DAYS=30
# HISTORY_LIMIT=20
# BROWSER_CHANNEL=msedge
